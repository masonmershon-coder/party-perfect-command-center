{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-handoff.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "CURSOR_TO_CLAUDE.md|CURRENT_TASK.md|PING.json|BLOCKERS.md",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/file-changed-handoff.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-handoff.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
