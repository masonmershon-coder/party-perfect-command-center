# xAI Grok (required for agents, drafts, recaps)
XAI_API_KEY=

# Twilio SMS — Mike weekly / test SMS (required for SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MANAGER_PHONE=+19188084311

# Optional: override writable data directory (defaults to ./data locally, /tmp on Vercel)
# DATA_DIR=

# GoDaddy Workspace Email (IMAP) — passwords ONLY in env, never in git
IMAP_HOST=imap.secureserver.net
IMAP_PORT=993

EMAIL_COMPANY_ADDRESS=Rentals@partyperfecteventrental.com
EMAIL_COMPANY_IMAP_PASSWORD=

EMAIL_JOSH_ADDRESS=info@mershonevents.com
EMAIL_JOSH_IMAP_PASSWORD=

EMAIL_MICHELLE_ADDRESS=michelle@partyperfecteventrental.com
EMAIL_MICHELLE_IMAP_PASSWORD=

# Meta (Facebook + Instagram) OAuth — secrets ONLY in env
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=https://YOUR_DOMAIN/api/auth/meta/callback
META_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_NAME=Party Perfect Event Rentals
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_HANDLE=@partyperfecteventrental

# Optional GitHub export
GITHUB_TOKEN=
GITHUB_REPO=
