# xAI Grok (required for agents, drafts, recaps)
XAI_API_KEY=

# Twilio SMS — Mike weekly / test SMS (required for SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Messaging Service SID (A2P 10DLC or Toll-Free) — preferred sender for US SMS
TWILIO_MESSAGING_SERVICE_SID=
MANAGER_PHONE=+19188084311
# Extra phones allowed to text Mike (comma-separated)
# MANAGER_PHONES=+19188084311,+19182895588
# Optional: only for local webhook testing (never in production)
# TWILIO_SKIP_SIGNATURE_CHECK=1

# Optional: override writable data directory (defaults to ./data locally, /tmp on Vercel)
# DATA_DIR=

# Upstash Redis — primary durable store for emails, social, tasks, hiring, Mike SMS, POR snapshots
# Vercel → Storage → Create Upstash Redis (or KV). Copy REST URL + token.
# Also accepted: KV_REST_API_URL / KV_REST_API_TOKEN
# REQUIRED for PartyPerfectJobs applications + live POR sync (never miss a hire).
# See docs/REDIS_SETUP.md
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob — optional legacy/migration only (not for hot dashboard reads)
# BLOB_READ_WRITE_TOKEN=

# Point of Rental read-only sync (ENTERPRISE push → Command Center)
# Shared secret for POST /api/por/sync Authorization: Bearer <secret>
# Generate a long random string; set the same value on ENTERPRISE sync agent config.
POR_SYNC_SECRET=

# GoDaddy Workspace Email (IMAP) — passwords ONLY in env, never in git
IMAP_HOST=imap.secureserver.net
IMAP_PORT=993

EMAIL_COMPANY_ADDRESS=Rentals@partyperfecteventrental.com
EMAIL_COMPANY_IMAP_PASSWORD=

EMAIL_JOSH_ADDRESS=info@mershonevents.com
EMAIL_JOSH_IMAP_PASSWORD=

EMAIL_MICHELLE_ADDRESS=michelle@partyperfecteventrental.com
EMAIL_MICHELLE_IMAP_PASSWORD=

# SMTP backup — every job application emailed to Josh + Rentals
# GoDaddy: smtpout.secureserver.net port 465 (see docs/JOBS_DNS.md)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
# Defaults to EMAIL_COMPANY_ADDRESS / EMAIL_COMPANY_IMAP_PASSWORD if omitted
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Party Perfect Hiring <Rentals@partyperfecteventrental.com>
# JOB_APPLICATION_BACKUP_TO=info@mershonevents.com,Rentals@partyperfecteventrental.com

# Meta (Facebook + Instagram) Graph API — secrets ONLY in env
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_OAUTH_REDIRECT_URI=https://YOUR_DOMAIN/api/auth/meta/callback
META_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_NAME=Party Perfect Event Rentals
INSTAGRAM_HANDLE=@partyperfecteventrental

# 24/7 Madison/Mike social cron — Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Optional GitHub export
GITHUB_TOKEN=
GITHUB_REPO=
