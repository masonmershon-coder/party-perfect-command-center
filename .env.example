# xAI Grok (required for agents, drafts, recaps; also Design Studio fallback)
XAI_API_KEY=

# Fal.ai — Madison Design Studio photoreal engine (Flux). Preferred for realistic looks.
# Get a key at https://fal.ai/dashboard/keys — set the same in Vercel env.
# FAL_KEY=
# Optional force: auto | flux | xai
# MADISON_IMAGE_ENGINE=auto

# Twilio SMS — Mike weekly / test SMS (required for SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Messaging Service SID (A2P 10DLC or Toll-Free) — preferred sender for US SMS
TWILIO_MESSAGING_SERVICE_SID=
MANAGER_PHONE=+19188084311
# Extra phones allowed to text Mike (comma-separated). 918-289-5588 is already built-in.
# MANAGER_PHONES=+19185551212
# Optional: only for local webhook testing (never in production)
# TWILIO_SKIP_SIGNATURE_CHECK=1

# Optional: override writable data directory (defaults to ./data locally, /tmp on Vercel)
# DATA_DIR=

# Upstash Redis — primary durable store for emails, social, tasks, hiring, Mike SMS, POR snapshots
# Vercel → Storage → Create Upstash Redis (or KV). Copy REST URL + token.
# Also accepted: KV_REST_API_URL / KV_REST_API_TOKEN
# REQUIRED for PartyPerfectJobs applications + live POR sync (never miss a hire).
# See docs/REDIS_SETUP.md
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob — optional legacy/migration only (not for hot dashboard reads)
# BLOB_READ_WRITE_TOKEN=

# Point of Rental read-only sync (ENTERPRISE push → Command Center)
# Shared secret for POST /api/por/sync Authorization: Bearer <secret>
# Generate a long random string; set the same value on ENTERPRISE sync agent config.
POR_SYNC_SECRET=

# SESSION_SECRET — HMAC key for signed cookies (min 16 chars). REQUIRED in production.
# SESSION_SECRET=

# AUTH_PASSWORD — team login. REQUIRED in production.
# AUTH_PASSWORD=

# OWNER_ADMIN_CODE — owner unlock PIN (exactly 4 digits). REQUIRED in production.
# OWNER_ADMIN_CODE=
# OWNER_PIN — accepted alias for OWNER_ADMIN_CODE (same 4-digit value).
# OWNER_PIN=

# XAI chat model (optional; defaults grok-4.3 / fallback grok-build-0.1)
# XAI_CHAT_MODEL=grok-4.3
# XAI_CHAT_MODEL_FALLBACK=grok-build-0.1

# Supabase Postgres — POR mirror (por.*). Prefer Transaction pooler :6543 for serverless app;
# use Session/direct for bulk ingest. Project: Party Perfect App (wkwksjitkyhaqgrxasml).
# DATABASE_URL=postgresql://postgres.<ref>:***@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Kituwa (Mason personal OS) — never commit values
# KITUWA_OWNER_PIN=
# KITUWA_SESSION_SECRET=
# KITUWA_WORKER_TOKEN=

# Square Payment Links (hosted checkout — no PAN stored in Command Center)
# SQUARE_ACCESS_TOKEN=
# SQUARE_LOCATION_ID=
# SQUARE_ENV=production
# Shadow Mode (PP Time management sync) also needs Labor Timecards read on the same token:
# TIMECARDS_READ (+ TEAM_READ recommended). No Square write-back in Shadow Mode.
# Hourly cron: GET /api/cron/time-square-sync Authorization: Bearer CRON_SECRET

# Owner SMS phones that may receive AR/$ via Mike text (comma-separated E.164). Defaults to managers.
# OWNER_SMS_PHONES=

# GoDaddy Workspace Email (IMAP) — passwords ONLY in env, never in git
IMAP_HOST=imap.secureserver.net
IMAP_PORT=993

EMAIL_COMPANY_ADDRESS=Rentals@partyperfecteventrental.com
EMAIL_COMPANY_IMAP_PASSWORD=

EMAIL_JOSH_ADDRESS=info@mershonevents.com
EMAIL_JOSH_IMAP_PASSWORD=

EMAIL_MICHELLE_ADDRESS=michelle@partyperfecteventrental.com
EMAIL_MICHELLE_IMAP_PASSWORD=

# SMTP backup — every job application emailed to Josh + Rentals
# GoDaddy: smtpout.secureserver.net port 465 (see docs/JOBS_DNS.md)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
# Defaults to EMAIL_COMPANY_ADDRESS / EMAIL_COMPANY_IMAP_PASSWORD if omitted
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Party Perfect Hiring <Rentals@partyperfecteventrental.com>
# JOB_APPLICATION_BACKUP_TO=info@mershonevents.com,Rentals@partyperfecteventrental.com

# Meta (Facebook + Instagram) Graph API — secrets ONLY in env
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_OAUTH_REDIRECT_URI=https://partyperfect.app/api/auth/meta/callback
META_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_NAME=Party Perfect Event Rentals
INSTAGRAM_HANDLE=@partyperfecteventrental

# Google Ads (not AdSense) — OAuth only, NEVER store Gmail passwords
# See docs/GOOGLE_ADS.md
GOOGLE_ADS_ACCOUNT_EMAIL=Partyperfectok@gmail.com
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_OAUTH_REDIRECT_URI=https://partyperfect.app/api/auth/google-ads/callback

# 24/7 Madison/Mike social cron — Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Public Command Center URL
# NEXT_PUBLIC_APP_URL=https://partyperfect.app
# APP_URL=https://partyperfect.app

# Optional GitHub export
GITHUB_TOKEN=
GITHUB_REPO=
