+/** Terminal states — a run here is finished for the day; a later command may start a new one. */
+export const TERMINAL_STATES = new Set(["MORNING_REPORT_READY", "PARTIAL", "FAILED"]);
+export const isActiveStatus = (status) => EOD_STATES.includes(status) && !TERMINAL_STATES.has(status);
+
+/**
+ * The in-flight run for today in this mode, if any. Powers the resend guard: a fresh
+ * command (new message event) that arrives WHILE a run is still going returns this run
+ * instead of racing a second one. A run that already finished (terminal) is not returned,
+ * so re-running later in the day is still allowed. Newest match wins.
+ */
+export function activeRunForToday({ mode, date = businessDate() } = {}) {
+  const entries = indexRuns().filter((e) => (mode ? e.mode === mode : true));
+  for (let i = entries.length - 1; i >= 0; i--) {
+    const run = loadRun(entries[i].eod_run_id);
+    if (run && run.business_date === date && isActiveStatus(run.status)) return run;
+  }
+  return null;
+}
