{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["iad1"],
  "functions": {
    "app/api/**/*": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/social",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/weekly-recap",
      "schedule": "0 14 * * 1"
    }
  ]
}
